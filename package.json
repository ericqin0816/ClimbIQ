{
  "name": "climbiq-detection-lab",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "benchmark:summary": "node scripts/summarize-real-video-benchmark.mjs",
    "benchmark:timing": "node e2e/real-video-timing.mjs",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vitest": "4.1.10"
  }
}
