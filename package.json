{
  "name": "climbiq-detection-lab",
  "private": true,
  "version": "0.29.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "benchmark:summary": "node scripts/summarize-real-video-benchmark.mjs",
    "benchmark:timing": "node e2e/real-video-timing.mjs",
    "benchmark:robustness": "node scripts/run-video-robustness.mjs",
    "benchmark:compare": "node scripts/compare-video-runs.mjs",
    "test:cancellation": "node e2e/analysis-cancellation.mjs",
    "test:audio-browser": "node e2e/audio-decoding.mjs",
    "test:finish-review": "node e2e/finish-review.mjs",
    "test:source-frames": "node e2e/source-frame-refinement.mjs",
    "test:upload": "node e2e/upload-flow.mjs",
    "test:coaching": "node e2e/coaching-review.mjs",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run test:coaching-server",
    "test:coaching-server": "tsc -p tsconfig.coaching-server.json && node scripts/check-coaching-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.45",
    "@mediapipe/tasks-vision": "0.10.35",
    "@vitejs/plugin-react": "^5.1.2",
    "ai": "^7.0.94",
    "nanoid": "^6.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vitest": "4.1.10"
  }
}
